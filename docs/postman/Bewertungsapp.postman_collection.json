    {
      "name": "Post teams",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status ist 201\", () => pm.response.to.have.status(201));",
              "",
              "pm.test(\"Antwort enthält id, name und klasse\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json.name).to.eql(\"Team Blockchain\");",
              "  pm.expect(json.klasse).to.eql(\"4AHITL\");",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "  pm.environment.set(\"teamId\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Team Blockchain\",\"klasse\":\"4AHITL\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/teams",
          "host": [
