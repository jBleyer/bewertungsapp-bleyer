    {
      "name": "GET eval. proj. durchschnitt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status ist 200\", () => pm.response.to.have.status(200));\n\npm.test(\"Antwort ist ein Array mit dem erwarteten Aufbau\", () => {\n  const json = pm.response.json();\n  pm.expect(json).to.be.an('array').with.lengthOf(1);\n  pm.expect(json[0]).to.have.all.keys(\n    'criterionId', 'kriterium', 'maxScore', 'durchschnitt', 'anzahlBewertungen'\n  );\n});\n\npm.test(\"Durchschnitt aus 8 und 10 ist 9\", () => {\n  const eintrag = pm.response.json()[0];\n  pm.expect(eintrag.durchschnitt).to.eql(9);\n  pm.expect(eintrag.anzahlBewertungen).to.eql(2);\n});"
            ]
          }
        }
      ],
