    {
      "name": "Post eval.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status ist 400 bei zu hohem score\", () => {\n  pm.response.to.have.status(400);\n});\n\npm.test(\"Fehlermeldung nennt den erlaubten Bereich\", () => {\n  pm.expect(pm.response.json().error).to.include(\"zwischen 0 und\");\n});\n\npm.test(\"Status ist 409 bei doppelter Bewertung\", () => {\n  pm.response.to.have.status(409);\n});\n\npm.test(\"Antwort enthält eine Fehlermeldung\", () => {\n  pm.expect(pm.response.json()).to.have.property('error');\n});"
            ]
          }
        }
      ],
